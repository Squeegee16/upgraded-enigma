# Ham Radio Application - Environment Variables
# ==============================================
# Raspberry Pi 5 (aarch64) specific settings
# The OpenWebRX stable image supports ARM64
# jketterl/openwebrx:stable

# If any image does not have ARM64 support use:
# platform: linux/aarch64
# in the service definition

# Memory limits suitable for Pi 5 (8GB model)
# Adjust if using 4GB model

# Flask Application Settings
FLASK_ENV=development
FLASK_DEBUG=1

# SECRET_KEY is now auto-generated if not provided
# Uncomment and set your own key for production:
# SECRET_KEY=your-secure-key-here
# 
# To generate a secure key:
# python3 -c 'import secrets; print(secrets.token_hex(32))'

# Database Configuration
DATABASE_URL=sqlite:////data/db/ham_radio.db

# ============================================================
# Hardware Device Configuration
# ============================================================

# Set to false to use real hardware
USE_MOCK_DEVICES=false

# RTL-SDR device index (0 = first dongle)
SDR_DEVICE_INDEX=0
SDR_SAMPLE_RATE=2048000

# GPS serial port (check: ls -l /dev/ttyUSB*)
GPS_SERIAL_PORT=/dev/ttyAMA0
GPS_BAUD_RATE=9600

# Radio CAT port
RADIO_PORT=/dev/ttyUSB1
RADIO_BAUD_RATE=38400
RADIO_MODEL=1035

# SSL/TLS Configuration
USE_SSL=true
SSL_CERT=/data/certs/cert.pem
SSL_KEY=/data/certs/key.pem

# ============================================================
# GPS Configuration
# ============================================================

# GPS source: uart | gpsd | mock
# uart  = Direct UART serial (Raspberry Pi GPIO or USB)
# gpsd  = System gpsd daemon (shared GPS)
# mock  = Simulated GPS (no hardware needed)
GPS_SOURCE=uart

# UART serial port path
# Raspberry Pi 4/5 hardware UART: /dev/ttyAMA0
# USB GPS dongle:                  /dev/ttyUSB0
# Raspberry Pi Zero/1:             /dev/ttyS0
GPS_SERIAL_PORT=/dev/ttyAMA0

# Serial baud rate (9600 for most GPS modules)
GPS_BAUD_RATE=9600

# gpsd host and port (only used when GPS_SOURCE=gpsd)
GPSD_HOST=127.0.0.1
GPSD_PORT=2947

# Maidenhead grid precision: 4, 6 (default), or 8
GRID_PRECISION=6

# Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Callsign Validation
VALIDATE_CALLSIGNS=false
CALLSIGN_FILE=/data/callsigns/callsigns.txt

# Timezone
TZ=UTC

# Backup Configuration
BACKUP_INTERVAL=86400
BACKUP_RETENTION=7

# ============================================================
# USB Sound Card (Creative SoundBlaster Play 3)
# ============================================================
# Leave blank for auto-detection in docker-entrypoint.sh
# Set manually if auto-detection picks the wrong card.
#
# Find your card number on the host:
#   aplay -l | grep -i soundblaster
#   aplay -l | grep -i usb
#
# Format: hw:CARD_NUMBER,0  (e.g. hw:1,0)
#
AUDIO_OUTPUT_DEVICE=
AUDIO_INPUT_DEVICE=

# Alternative: use PulseAudio device name
# AUDIO_OUTPUT_DEVICE=pulse
# AUDIO_INPUT_DEVICE=pulse
